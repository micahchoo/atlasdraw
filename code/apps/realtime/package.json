{
  "name": "@atlasdraw/realtime",
  "version": "0.0.0",
  "description": "Atlasdraw realtime relay — one Y.Doc per room over the y-websocket protocol, persisted to SQLite",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test:typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@atlasdraw/protocol": "0.0.0",
    "better-sqlite3": "^11",
    "lib0": "^0.2.99",
    "pino": "10.3.1",
    "ws": "^8.21.1",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "*",
    "@types/node": "*",
    "@types/ws": "^8.18.1",
    "tsx": "^4.7.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "y-websocket": "^2.0.0"
  }
}
