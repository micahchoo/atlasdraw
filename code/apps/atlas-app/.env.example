# Atlas-app build variables. Copy to `.env.local` (git-ignored) and edit.
# Vite reads them at build time; src/config/app-config.ts checks them at boot
# and names a bad one. Each line below shows the default.

# What the build is: "local-only" (maps stay in the browser), "hosted" (the
# storage server saves maps; rooms are possible) or "pages" (GitHub Pages,
# served under /atlasdraw/).
VITE_BUILD_TARGET=local-only

# The storage HTTP API. Empty: the same origin. Read by hosted builds only.
VITE_STORAGE_BASE_URL=

# Rooms. They need a hosted build and a relay. An empty URL means the same
# origin.
VITE_REALTIME_ENABLED=false
VITE_REALTIME_WS_URL=

# A Photon-compatible geocoder. Empty: place search uses only the bundled
# index (public/data/places-index.json) and calls no one.
VITE_GEOCODER_ENDPOINT=

# Remote basemaps (OpenFreeMap "Bright", OSM). "true" fetches their tiles
# from third-party hosts. "false" keeps only the offline basemaps (Light,
# Dark). See docs/architecture/adr/0006-telemetry.md "Update (2026-06-13)".
VITE_ALLOW_REMOTE_BASEMAPS=true

# The /embed route. "false" opens the editor there instead.
VITE_EMBED_ENABLED=true

# The offline basemap archive. Unset: data/world-low-zoom.pmtiles under the
# base path. The browser must reach it.
# VITE_PMTILES_PATH=/data/world-low-zoom.pmtiles

# Origins the page may connect to besides its own and the built-in
# basemaps, space-separated (content security policy connect-src). For tile
# layers on other servers. Read by `vite build` only.
VITE_CSP_CONNECT_SRC=

# Keep window.__atlasdraw__ in a production build. For the production-build
# e2e only; never set it for a deploy (.claude/rules/production-e2e.md).
# VITE_E2E_HOOKS=1

# VITE_APP_VERSION and VITE_GIT_HASH are written by vite.config.ts from
# package.json and `git rev-parse`; a value here has no effect.
