# Atlasdraw — full-stack compose env (infra/docker-compose.yml).
# Copy to .env in the repository root (NOT committed) and edit. Compose does
# not read that file by itself; pass it on every command:
#   docker compose --env-file .env -f infra/docker-compose.yml up -d --build

# ---- public-facing identity --------------------------------------------
# The hostname Caddy serves on. Caddy will provision a Let's Encrypt cert
# for this domain. For local testing, set to localhost and override the
# `tls` line in Caddyfile to `tls internal`.
PUBLIC_DOMAIN=atlas.example.com

# Email address Let's Encrypt uses for cert-renewal notifications. Mandatory
# for production. Ignored (but still required to be set) when tls internal.
ACME_EMAIL=ops@example.com

# ---- storage server ----------------------------------------------------
# pino log level. One of fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# Opt-in error capture. Leave it blank and the server calls no one
# (docs/architecture/adr/0006-telemetry.md). Set it, and say so in your
# privacy policy (docs/architecture/adr/0009-error-capture.md).
SENTRY_DSN=

# Per-address HTTP rate limit (fixed window). RATE_LIMIT_MAX requests per
# RATE_LIMIT_WINDOW_MS per client address (an IPv6 client counts by its
# /64); /health is always exempt. RATE_LIMIT_MAX=0 turns it off.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Storage limits (docs/self-host/production.md "Storage limits"). Never
# leave one empty: an empty number reads as 0, which means "no limit".
# The sum of all stored maps, in bytes (10 GiB). 0: no cap.
MAX_TOTAL_BYTES=10737418240
# The largest map one request may store, in bytes (50 MiB).
MAX_MAP_BYTES=52428800
# New maps per client address per hour. 0: no limit.
MAX_NEW_MAPS_PER_IP=60
# Requests one client address may have open at once. 0: no limit.
MAX_CONCURRENT_PER_IP=16
# How often expired share links and old keyless maps are deleted, in ms.
# 0: never.
SWEEP_INTERVAL_MS=3600000
# Maps stored before write keys are kept this many days after the upgrade.
LEGACY_MAP_GRACE_DAYS=90
# Earlier versions kept of each map, besides its latest bytes. They count
# against MAX_TOTAL_BYTES. 0: no history.
MAP_VERSIONS_KEPT=20
# The least time between two kept versions, in minutes. 0: keep every save.
MAP_VERSION_INTERVAL_MINUTES=10

# ---- realtime relay (compose profile: realtime) ------------------------
# Rooms are saved in the `roomsdata` volume. Limits (optional): MAX_ROOMS,
# MAX_ROOM_SIZE, MAX_MESSAGE_BYTES, MAX_ROOM_BYTES, MAX_TOTAL_ROOM_BYTES,
# MAX_NEW_ROOMS_PER_IP, MAX_CONNECTIONS_PER_IP, ROOM_EXPIRY_DAYS,
# ROOM_SWEEP_INTERVAL_MS — see docs/self-host/production.md "Realtime relay".

# ---- web build (read when the image is built) ---------------------------
# Rooms: "true" also needs the realtime profile. An empty URL means the same
# origin; Caddy routes /yjs to the relay.
VITE_REALTIME_ENABLED=false
VITE_REALTIME_WS_URL=
# A Photon-compatible geocoder. Empty: place search uses only the bundled
# index and calls no one.
VITE_GEOCODER_ENDPOINT=
# Tile servers the page may reach besides the built-in basemaps,
# space-separated origins (content security policy connect-src).
VITE_CSP_CONNECT_SRC=

# ---- Postgres (metadata) ----------------------------------------------
POSTGRES_USER=atlasdraw
POSTGRES_PASSWORD=changeme-postgres
POSTGRES_DB=atlasdraw

# ---- Blob storage: your S3-compatible bucket --------------------------
# This stack runs no object store. Point these at a bucket you control
# (AWS S3, Cloudflare R2, Backblaze B2, Garage, SeaweedFS, your own MinIO).
# Use an access key limited to this one bucket. The storage server makes the
# bucket if it does not exist and the key may create it.
BLOB_ENDPOINT=https://s3.example.com
BLOB_ACCESS_KEY=changeme-access-key
BLOB_SECRET_KEY=changeme-secret-key
BLOB_BUCKET=atlasdraw-maps
BLOB_REGION=us-east-1
# "true" (path-style: endpoint/bucket/key) suits most self-hosted servers.
# Set "false" for virtual-hosted URLs (bucket.endpoint/key), e.g. AWS S3.
BLOB_FORCE_PATH_STYLE=true

# ---- Map embed (/embed) framing ---------------------------------------
# Who may embed your maps in a cross-origin <iframe>. Default `*` (any site —
# zero-config first run). Tighten to a space-separated allowlist to restrict,
# e.g. EMBED_FRAME_ANCESTORS="https://yournewsroom.example https://blog.example".
# Emitted as a CSP `frame-ancestors` header on /embed pages by the web
# container; every other page may be framed only by its own origin. See
# docs/architecture/adr/0012-embed-frame-ancestors.md.
EMBED_FRAME_ANCESTORS=*
