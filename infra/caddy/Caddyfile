# Atlasdraw — Caddy reverse-proxy config for the full production stack.
#
# Routes:
#   /api/*       → storage (Caddy strips the /api prefix; storage serves its
#                  own routes at /maps, /share, /health, etc.)
#   /yjs/*       → realtime relay (y-websocket; WebSocket upgrade proxied).
#                  The URL carries only the room id; the room token is the
#                  first WebSocket message, so access logs never hold it.
#   /*           → web (atlas-app dist via nginx on port 3000)
#
# The realtime routes only respond when the `realtime` compose profile is up;
# otherwise Caddy 502s that path (the relay is not published to the host — it
# is reachable only on the compose network, through this proxy, over TLS).
#
# TLS: automatic via Let's Encrypt ACME (production) — operators MUST set
# ACME_EMAIL in .env. For local-host testing, override the `tls` line:
#   tls internal
# or comment out the entire `tls` directive and use http://${PUBLIC_DOMAIN}.

# Global options. The default log carries the handlers' own messages (the
# reverse proxy logs a request it could not finish, with its URI after /api
# was stripped), so it gets the same share-token filter as the access log.
{
	log {
		format filter {
			wrap json
			request>uri regexp "^/(api/share|share|m|embed)/[^/?#]+" "/${1}/[redacted]"
			request>headers>Referer regexp "/(m|embed)/[^/?#]+" "/${1}/[redacted]"
		}
	}
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy storage:4000
	}

	# Realtime relay — full path preserved (the relay serves /yjs/<roomId>).
	# Caddy proxies the WebSocket Upgrade handshake, so TLS ends here.
	handle /yjs/* {
		reverse_proxy realtime:4001
	}

	handle {
		# The web container sends the page's frame-ancestors header itself,
		# per path (/embed from EMBED_FRAME_ANCESTORS, every other page only
		# from this origin; code/apps/atlas-app/nginx.conf). The rest of the
		# content security policy is a <meta> in index.html. Caddy passes
		# both through and adds no policy of its own: two policies would both
		# apply. See docs/architecture/adr/0012-embed-frame-ancestors.md.
		reverse_proxy web:3000
	}

	tls {$ACME_EMAIL}

	# A share token is a read capability, and it travels in the path
	# (/m/<token>, /embed/<token>, /api/share/<token>/blob) and in the Referer
	# of what those pages fetch. The access log writes [redacted] instead, so
	# shipping this log to an aggregator does not ship the links.
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp "^/(api/share|share|m|embed)/[^/?#]+" "/${1}/[redacted]"
			request>headers>Referer regexp "/(m|embed)/[^/?#]+" "/${1}/[redacted]"
		}
		level INFO
	}
}
